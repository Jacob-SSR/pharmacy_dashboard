# ── HOSxP (MySQL) ─────────────────────────────────────────────────────────────
# ใช้ผู้ใช้ที่มีสิทธิ์ SELECT อย่างเดียว — จอนี้ไม่เขียนอะไรกลับเข้า HOSxP
DB_HOST=10.0.0.1
DB_PORT=3306
DB_USER=readonly_user
DB_PASS=
DB_NAME=hosxp_pcu

# ── ห้องยา ────────────────────────────────────────────────────────────────────
# ⚠️ จำเป็น — depcode ของจุดจ่ายยา (kskdepartment.depcode) คั่นด้วย comma
#
# ค่าของ รพ.พลับพลาชัย = 008,060,061  (ยืนยันจากซอร์สจอเดิม moneyAndDrug.php
#   008 ห้องยา = ที่คนไข้นั่งรอ · 060 จ่ายยา ก · 061 จ่ายยา ข = จุดที่กดเรียกคิว)
#   ถ้าใส่แค่ 008 ช่อง "จ่ายยา" จะเป็น 0 ตลอด เพราะการเรียกคิวบันทึกที่ 060/061
PHARMACY_DEPCODES=008,060,061

# รายการยาตั้งแต่เท่านี้ขึ้นไป = ตะกร้า "ยามาก"
PHARMACY_MANY_ITEMS=4

# รอเกินกี่นาทีจึงขึ้นแถบเตือนด้านบน
PHARMACY_URGENT_WAIT_MIN=20

# จอดึงข้อมูลใหม่ทุกกี่มิลลิวินาที
PHARMACY_REFRESH_MS=30000

# จำกัดจำนวนแถวต่อรอบ กันแถวบวมเวลาข้อมูลเพี้ยน
PHARMACY_ROW_LIMIT=500


# ── ขนาด connection pool ──────────────────────────────────────────────────────
DB_POOL_SIZE=6
DB_POOL_IDLE=3
DB_QUEUE_LIMIT=50

# ── ระบบเสียงเรียกชื่อ (Google TTS ตัวเดิมที่จอเก่าใช้) ────────────────────────
# อ่านอย่างเดียว ไม่เขียน HOSxP → รันคู่กับจอ PHP เดิมได้ ไม่แย่งกัน
# แต่ควรเปิด ?voice=1 แค่ "จอเดียว" ในห้อง ไม่งั้นเสียงซ้อนกัน
#
# เครื่องที่รัน docker ต้องออกเน็ตไปหา translate.google.com ได้
# เช็คได้ที่ /api/tts?text=ทดสอบ&debug=1
PHARMACY_VOICE=0

# จอที่เปิดเสียงถามหาคิวใหม่ทุกกี่ ms
PHARMACY_VOICE_POLL_MS=5000

# ความเร็วเสียง 1 = เท่าจอเดิมเป๊ะ (Google รับ 0.1–1)
TTS_RATE=1
