# ── HOSxP (MySQL) ─────────────────────────────────────────────────────────────
# ใช้ผู้ใช้ที่มีสิทธิ์ SELECT อย่างเดียว — จอนี้ไม่เขียนอะไรกลับเข้า HOSxP
DB_HOST=10.0.0.1
DB_PORT=3306
DB_USER=readonly_user
DB_PASS=
DB_NAME=hosxp_pcu

# ── ห้องยา ────────────────────────────────────────────────────────────────────
# ⚠️ จำเป็น — depcode ของจุดจ่ายยา (kskdepartment.depcode) คั่นด้วย comma
# เป็นค่าเดียวกับที่สคริปต์เดิมส่งเข้า getMedicineQ.php / getScreeningW.php
# ไม่ตั้งค่านี้ = query ไม่ได้ (จอจะขึ้นข้อความบอกให้มาตั้ง)
PHARMACY_DEPCODES=

# รายการยาตั้งแต่เท่านี้ขึ้นไป = ตะกร้า "ยามาก"
PHARMACY_MANY_ITEMS=4

# รอเกินกี่นาทีจึงขึ้นแถบเตือนด้านบน
PHARMACY_URGENT_WAIT_MIN=20

# จอดึงข้อมูลใหม่ทุกกี่มิลลิวินาที
PHARMACY_REFRESH_MS=30000

# จำกัดจำนวนแถวต่อรอบ กันแถวบวมเวลาข้อมูลเพี้ยน
PHARMACY_ROW_LIMIT=500


# ── ขนาด connection pool ──────────────────────────────────────────────────────
DB_POOL_SIZE=6
DB_POOL_IDLE=3
DB_QUEUE_LIMIT=50
